# Board API (BFF) configuration.
#
# Copy to .env for local development:  cp env.example .env
# (.env is gitignored; never commit a filled copy.)
#
# Everything here is validated by src/config.ts at startup. A missing or
# malformed variable aborts the process with ONE error listing every problem at
# once, so a single restart tells you everything that is wrong. Secret values
# are never echoed back — the error says "value not shown".

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your Azure DevOps organisation. Must be https; a trailing slash is trimmed.
# One organisation only — cross-organisation boards are out of scope.
ADO_ORG_URL=https://dev.azure.com/expertgroup

# The SERVICE identity credential, used for READS ONLY.
#
# Reads run under one identity so every user shares one warm cache and one
# rate-limit budget — that is what makes the board fast. Writes never use this
# token: they carry the calling user's own, so history and notifications in
# Azure Boards attribute the change to the person who made it rather than to a
# service account.
#
# Needs work item read and project read across every project a board covers.
ADO_SERVICE_TOKEN=

# Config store: board definitions, column mappings, person overrides, audit
# log. It holds no work item content.
DATABASE_URL=postgres://board:board@localhost:5432/board

# Cache. Card snapshots live here for 60 seconds, so a cache dump contains at
# most one minute of titles and assignees.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Optional — shown with their defaults
# ---------------------------------------------------------------------------

PORT=8080

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Every outbound call has an explicit timeout. There is no unbounded await in
# the service, and these are the knobs.
ADO_REQUEST_TIMEOUT_MS=10000
REDIS_REQUEST_TIMEOUT_MS=1000
DATABASE_REQUEST_TIMEOUT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=15000

# Sync worker. It warms the cache ahead of the user and shares the service
# identity's rate budget with the interactive path, so it runs at low
# concurrency and backs off first. Raising these makes mornings faster and
# makes a user's board slower when the two collide.
SYNC_CONCURRENCY=2
SYNC_RATE_BUDGET_PER_MINUTE=200

# Cache TTLs in seconds, from the spec's cache table. 0 means no expiry.
# Lowering the snapshot TTL raises Azure DevOps load roughly linearly.
CACHE_TTL_PROJECTS_TEAMS_SECONDS=86400
CACHE_TTL_TEAM_METADATA_SECONDS=21600
CACHE_TTL_BOARD_COLUMNS_SECONDS=21600
CACHE_TTL_CAPACITY_SECONDS=3600
CACHE_TTL_BOARD_SNAPSHOT_SECONDS=60
CACHE_TTL_COLUMN_MAPPING_SECONDS=0
CACHE_TTL_ACL_SECONDS=900

# ---------------------------------------------------------------------------
# Service hooks (optional)
# ---------------------------------------------------------------------------
#
# Credentials the workitem.updated service hook presents when it calls our
# webhook. Configure EITHER the basic pair OR the shared-secret pair.
#
# Leave all four unset and the webhook route is NOT MOUNTED AT ALL — there is
# no unauthenticated endpoint left sitting open. The hub then falls back to
# polling every 30 seconds and shows "live updates off", so the degraded mode
# is visible rather than silent.
#
# Setting only half of a pair is a startup error, not a silent downgrade.

# WEBHOOK_BASIC_USERNAME=
# WEBHOOK_BASIC_PASSWORD=

# WEBHOOK_SECRET_HEADER=x-board-webhook-secret
# WEBHOOK_SHARED_SECRET=
