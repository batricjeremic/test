    "@fastify/helmet": "^13.0.1",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.9.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
